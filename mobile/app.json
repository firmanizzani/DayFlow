{
  "expo": {
    "name": "Dayflow",
    "slug": "dayflow",
    "scheme": "dayflow",
    "icon": "./assets/icon.png",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.dailyflow.app" },
    "android": { "package": "com.dailyflow.app", "edgeToEdgeEnabled": true },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "experiments": { "typedRoutes": true },
    "splash": {
      "backgroundColor": "#393276",
      "image": "./assets/splash.png",
      "resizeMode": "contain"
    },
    "web": { "bundler": "metro", "output": "single" }
  }
}
