{
  "expo": {
    "name": "Dayflow",
    "slug": "dayflow",
    "scheme": "dayflow",
    "icon": "./assets/icon.png",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.dailyflow.app" },
    "android": { "package": "com.dailyflow.app", "edgeToEdgeEnabled": true },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F9FD",
          "image": "./assets/splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#131425",
            "image": "./assets/splash-dark.png"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": { "typedRoutes": true },
    "splash": {
      "backgroundColor": "#F8F9FD",
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "dark": {
        "backgroundColor": "#131425",
        "image": "./assets/splash-dark.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    }
  }
}
